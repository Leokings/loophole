{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loophole-keeper-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "workers_dev": false,
  "vars": {
    "KEEPER_URL": "https://loophole-zeta.vercel.app/api/cron/advance"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
