{
  "name": "loophole-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "deploy:studionet": "node --env-file-if-exists=.env.local scripts/deploy-loophole.mjs studionet",
    "deploy:bradbury": "node --env-file-if-exists=.env.local scripts/deploy-loophole.mjs bradbury",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "hosting:configure": "node --env-file-if-exists=.env.local scripts/configure-vercel.mjs",
    "release:init": "node scripts/create-release-secrets.mjs",
    "release:status": "node --env-file-if-exists=.env.local scripts/release-status.mjs",
    "smoke:reviewer-wallet": "node scripts/reviewer-wallet-smoke.mjs"
  },
  "dependencies": {
    "genlayer-js": "1.1.8",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "22.x"
  }
}
